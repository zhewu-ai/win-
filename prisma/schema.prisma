generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  email             String?  @unique
  passwordHash      String
  displayName       String?
  avatarColor       String?
  avatarUrl         String?
  avatarStoragePath String?
  avatarMimeType    String?
  avatarSize        Int      @default(0)
  storageQuotaBytes Int      @default(10485760)
  storageUsedBytes  Int      @default(0)
  role              String   @default("user")
  status            String   @default("active")
  mustChangePassword Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastActiveAt      DateTime?
  lastActiveAction  String?
  notes             Note[]
  attachments       Attachment[]
  createdInvites    InviteCode[] @relation("InviteCreatedBy")
  usedInvites       InviteCode[] @relation("InviteUsedBy")
  passwordResetTokens PasswordResetToken[]
  feedbackTickets   FeedbackTicket[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  userActivityLogs  UserActivityLog[]
  calendarEvents    CalendarEvent[]
  workProjects      WorkProject[]
  workScheduleItems WorkScheduleItem[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model FeedbackTicket {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  content    String
  status     String   @default("open")
  pageUrl    String?
  userAgent  String?
  appVersion String?
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model InviteCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  createdById String
  usedById    String?
  status      String    @default("active")
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id])

  @@index([createdById])
  @@index([usedById])
  @@index([status])
}

model Note {
  id           String    @id @default(cuid())
  userId       String
  title        String    @default("")
  content      String    @default("")
  color        String    @default("yellow")
  isPinned     Boolean   @default(false)
  isArchived   Boolean   @default(false)
  mode         String    @default("text")
  checklistItems String  @default("[]")
  checklistGroups String @default("[]")
  sortOrder    Int       @default(0)
  windowX      Int?
  windowY      Int?
  windowWidth  Int?
  windowHeight Int?
  alwaysOnTop  Boolean   @default(false)
  isSample     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id])
  attachments Attachment[]
  calendarEvents CalendarEvent[]
  workScheduleItems WorkScheduleItem[]

  @@index([userId, deletedAt, isArchived])
  @@index([userId, isArchived, deletedAt])
}

model Attachment {
  id          String   @id @default(cuid())
  userId      String
  noteId      String
  type        String   @default("image")
  url         String
  storagePath String
  filename    String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  note Note @relation(fields: [noteId], references: [id])

  @@index([userId])
  @@index([noteId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  version     String?
  status      String    @default("draft") // draft | published | archived
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])
  reads     AnnouncementRead[]

  @@index([status])
  @@index([publishedAt])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId])
}

model UserActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  String? // JSON 字符串；禁止便签标题/正文/待办文字/反馈内容/附件原始名
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([action])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  noteId      String?
  title       String
  description String    @default("")
  date        String // YYYY-MM-DD，按用户本地日期存储
  startTime   String? // HH:mm，可空；全天事件为空
  endTime     String? // HH:mm，可空
  allDay      Boolean   @default(true)
  status      String    @default("todo") // todo | done | postponed
  source      String    @default("manual") // manual；M13 AI 导入阶段扩展 ai_import/image_import
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])
  note Note? @relation(fields: [noteId], references: [id])

  @@index([userId, date, deletedAt])
  @@index([userId, status])
  @@index([noteId])
}

// M12 工作日历：项目是排期容器，排期条目是月/周/今日三视图共同读取的基本单元。
model WorkProject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  colorKey    String   @default("blue") // blue | red | green | purple | gray
  status      String   @default("active") // active | archived
  startDate   String? // YYYY-MM-DD
  endDate     String? // YYYY-MM-DD
  description String   @default("")
  source      String   @default("manual") // manual；M13 AI 导入阶段扩展
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])
  scheduleItems WorkScheduleItem[]

  @@index([userId, status, deletedAt])
  @@index([userId, deletedAt])
}

model WorkScheduleItem {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  title     String
  type      String   @default("range") // range（连续阶段）| node（单日节点）
  startDate String // YYYY-MM-DD
  endDate   String // YYYY-MM-DD；node 与 startDate 相同
  status    String   @default("todo") // todo | done | postponed
  noteId    String?
  source    String   @default("manual") // manual；M13 AI 导入阶段扩展
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  project WorkProject @relation(fields: [projectId], references: [id])
  note Note? @relation(fields: [noteId], references: [id])

  @@index([userId, startDate, endDate, deletedAt])
  @@index([projectId, deletedAt])
  @@index([noteId])
  @@index([userId, status])
}
