{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "floating_*"
  ],
  "remote": {
    "urls": [
      "https://notes.hello-mylife.online/*",
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-open-floating-note",
    "allow-toggle-always-on-top",
    "allow-get-always-on-top"
  ]
}
