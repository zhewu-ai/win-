DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-this-to-a-random-secret-at-least-32-chars-long"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
UPLOAD_DIR="./uploads"
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_NOTE=12

# --- 维护接口（M8.7 回收站每日清理）---
# 生产必须设置：/api/trash-cleanup 要求 `Authorization: Bearer <此值>`，
# 并同步更新 systemd timer 的 curl 命令带上该头；未设置时退回回环来源判断。
TRASH_CLEANUP_SECRET="change-me-to-a-long-random-string"

# --- 忘记密码邮件（M10.6）---
# 重置链接的基础地址（生产必须是 https 域名）
APP_BASE_URL="http://localhost:3000"
# SMTP 配置；生产缺失时接口返回通用文案、服务端记错误日志，不崩溃
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# 仅本地开发：无 SMTP 时把发出的邮件写入该文件，便于端到端测试（生产不要设置）
# DEV_MAILBOX="./data/dev-mailbox.jsonl"

# --- AI 排期导入（M13）---
# 硅基流动 API Key：只写变量名，真实 key 由部署环境配置，严禁提交仓库
# 本地测试可配到 .env（已被 gitignore），生产通过 systemd 服务环境变量注入
SILICONFLOW_API_KEY=""
# 测试阶段模型（硅基流动模型标识）
SILICONFLOW_MODEL="Qwen/Qwen3.5-9B"
